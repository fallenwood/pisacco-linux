# PREPARATION only, not a native DSI implementation or hardware acceptance.
# Merge only into an isolated build with a distinct screenN module release.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=m
# Unknown native panel and incomplete SM7250 display-controller port: fail closed.
CONFIG_DRM_MSM=n
