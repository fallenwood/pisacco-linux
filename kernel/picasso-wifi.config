# Opt-in only: DTS_PROFILE=wifi. Do not silently change the installed server.
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=m
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_MAC80211=m
CONFIG_ATH_COMMON=m
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_ATH10K_PCI=n
CONFIG_ATH10K_AHB=n
CONFIG_ATH10K_SDIO=n
CONFIG_ATH10K_USB=n
CONFIG_ATH10K_DEBUG=y
CONFIG_ATH10K_DEBUGFS=y
CONFIG_ATH10K_TRACING=n
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_Q6V5_MSS=n
CONFIG_QCOM_Q6V5_WCSS=n
CONFIG_QCOM_RPROC_COMMON=m
CONFIG_QCOM_SYSMON=m
CONFIG_QCOM_SMP2P=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QRTR_TUN=n
CONFIG_QCOM_QMI_HELPERS=m
CONFIG_QCOM_PDR_HELPERS=m
CONFIG_QCOM_PD_MAPPER=m
# Starting Wi-Fi does not authorize IPA/cellular network or EFS storage access.
CONFIG_QCOM_IPA=n
