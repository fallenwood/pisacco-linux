+struct picasso_mgmt_observation {
+	struct sk_buff *skb;
+	u32 status;
+	u32 channel;
+};
+
+static void picasso_mgmt_observe_iter(void *data, u8 *mac,
+				      struct ieee80211_vif *vif)
+{
+	struct picasso_mgmt_observation *sample = data;
+	struct ieee80211_mgmt *mgmt = (void *)sample->skb->data;
+	struct ath10k_vif *arvif = (void *)vif->drv_priv;
+	int count, errors;
+
+	if (vif->type != NL80211_IFTYPE_STATION ||
+	    !ether_addr_equal(mgmt->bssid, vif->bss_conf.bssid))
+		return;
+	count = atomic_inc_return(&picasso_pre_filter_beacons);
+	if (sample->status & (WMI_RX_STATUS_ERR_DECRYPT |
+	    WMI_RX_STATUS_ERR_KEY_CACHE_MISS | WMI_RX_STATUS_ERR_CRC))
+		atomic_inc(&picasso_pre_filter_errors);
+	errors = atomic_read(&picasso_pre_filter_errors);
+	if (count <= 4 || !(count % 64) || (errors && errors <= 4))
+		ath10k_info(arvif->ar,
+			    "Picasso link observation: pre_filter_beacon count %d errors %d status %u channel %u\n",
+			    count, errors, sample->status, sample->channel);
+}
+
+void ath10k_picasso_mgmt_observe(struct ath10k *ar, struct sk_buff *skb,
+			       u32 status, u32 channel);
+void ath10k_picasso_mgmt_observe(struct ath10k *ar, struct sk_buff *skb,
+			       u32 status, u32 channel)
+{
+	struct picasso_mgmt_observation sample = { skb, status, channel };
+	struct ieee80211_hdr *hdr = (void *)skb->data;
+
+	if (!ath10k_picasso_link_observing(ar) || skb->len < 24 ||
+	    !ieee80211_is_beacon(hdr->frame_control))
+		return;
+	ieee80211_iterate_active_interfaces_atomic(ar->hw,
+					   ATH10K_ITER_NORMAL_FLAGS,
+					   picasso_mgmt_observe_iter, &sample);
+}
