# Linux 6.18 LTS, headless bring-up; merged over arm64 defconfig.
CONFIG_LOCALVERSION="-picasso-lts"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_EFI=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_CMDLINE="earlycon=qcom_geni,0x888000 console=tty0 console=ttyMSM0,115200 rdinit=/init clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=0 enforcing=0"
CONFIG_CMDLINE_FORCE=y
CONFIG_ARCH_QCOM=y
CONFIG_SM_GCC_7250=y
CONFIG_PINCTRL_SM7250=y
CONFIG_INTERCONNECT_QCOM_SM7250=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SCM=y
CONFIG_MAILBOX=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_SMEM=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_QCOM=y
CONFIG_QCOM_LLCC=y
CONFIG_CPU_FREQ=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_THERMAL=y
CONFIG_QCOM_TSENS=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QCOM_WDT=y
CONFIG_POWER_RESET_MSM=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_XFS_FS=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_XFS_QUOTA=y
# Check metadata explicitly; online repair is not part of this device's acceptance.
CONFIG_XFS_ONLINE_SCRUB=y
CONFIG_XFS_ONLINE_REPAIR=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_G_SERIAL=n
CONFIG_USB_ETH=n
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_MSM=n
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_REMOTEPROC=n
CONFIG_PCI=n
CONFIG_VIRTUALIZATION=n
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_AUDIT=y
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux,bpf"
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UNIX98_PTYS=y
CONFIG_PSI=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
# Do not invent a ramoops address: obtain it from this phone's live DT first.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
