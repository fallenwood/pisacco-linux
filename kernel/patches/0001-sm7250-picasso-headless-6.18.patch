+		model = "Xiaomi Redmi K30 5G (Picasso) WCD9385";
+		audio-routing =
+			"IN1_HPHL",
+			"HPHL_OUT",
+			"IN2_HPHR",
+			"HPHR_OUT",
+			"IN3_AUX",
+			"AUX_OUT",
+			"AMIC1",
+			"MIC BIAS1",
+			"AMIC2",
+			"MIC BIAS2",
+			"AMIC5",
+			"MIC BIAS3",
+			"TX SWR_ADC0",
+			"ADC1_OUTPUT",
+			"TX SWR_ADC1",
+			"ADC2_OUTPUT",
+			"TX SWR_ADC2",
+			"ADC3_OUTPUT",
+			"TX SWR_ADC3",
+			"ADC4_OUTPUT",
+			"RX_TX DEC0_INP",
+			"TX DEC0 MUX",
+			"RX_TX DEC1_INP",
+			"TX DEC1 MUX",
+			"RX_TX DEC2_INP",
+			"TX DEC2 MUX",
+			"RX_TX DEC3_INP",
+			"TX DEC3 MUX",
+			"VA_AIF1 CAP",
+			"VA_SWR_CLK",
+			"VA_AIF2 CAP",
+			"VA_SWR_CLK",
+			"VA_AIF3 CAP",
+			"VA_SWR_CLK",
