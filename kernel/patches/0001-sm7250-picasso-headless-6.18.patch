+			"MIC BIAS3",
+			"VA DMIC1",
+			"MIC BIAS3",
+			"VA DMIC2",
+			"MIC BIAS1",
+			"VA DMIC3",
+			"MIC BIAS1",
+			"VA DMIC4",
+			"MIC BIAS4",
+			"VA DMIC5",
+			"MIC BIAS4",
+			"VA SWR_ADC0",
+			"ADC1_OUTPUT",
+			"VA SWR_ADC1",
+			"ADC2_OUTPUT",
+			"VA SWR_ADC2",
+			"ADC3_OUTPUT",
+			"VA SWR_ADC3",
+			"ADC4_OUTPUT";
+		mm1-dai-link {
+			link-name = "MultiMedia1";
+			cpu {
+				sound-dai = <&q6asmdai 0>;
+			};
+		};
+		mm2-dai-link {
+			link-name = "MultiMedia2";
+			cpu {
+				sound-dai = <&q6asmdai 1>;
+			};
+		};
+		mm3-dai-link {
+			link-name = "MultiMedia3";
+			cpu {
