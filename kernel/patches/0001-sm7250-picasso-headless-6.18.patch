+				arm,psci-suspend-param = <0x40000004>;
+				entry-latency-us = <0x2be>;
+				exit-latency-us = <0x393>;
+				min-residency-us = <0xfa1>;
+				local-timer-stop;
+			};
+			cpu_sleep_1_0: cpu-sleep-1-0 {
+				compatible = "arm,idle-state";
+				idle-state-name = "big-rail-power-collapse";
+				arm,psci-suspend-param = <0x40000004>;
+				entry-latency-us = <0x20e>;
+				exit-latency-us = <0x73e>;
+				min-residency-us = <0x15b3>;
+				local-timer-stop;
+			};
+			cluster_sleep_0_0: cluster-sleep-0-0 {
+				compatible = "arm,idle-state";
+				idle-state-name = "cluster-power-collapse";
+				arm,psci-suspend-param = <0x4100c244>;
+				entry-latency-us = <0xcbf>;
+				exit-latency-us = <0x19a2>;
+				min-residency-us = <0x2662>;
+				local-timer-stop;
+			};
+		};
+	};
+	memory: memory@80000000 {
+		device_type = "memory";
+		reg =
+			<0 0x80000000 0 0x3cc00000 0 0xc0000000 0 0x40000000 1 0 1 0>;
+	};
+	pmu {
+		compatible = "arm,armv8-pmuv3";
+		interrupts = <1 7 8>;
+	};
+	psci {
+		compatible = "arm,psci-1.0";
+		method = "smc";
+		cpu_pd0: power-domain-cpu0 {
+			#power-domain-cells = <0>;
+			power-domains = <&cluster_pd>;
+			domain-idle-states = <&cpu_sleep_0_0>;
+		};
+		cpu_pd1: power-domain-cpu1 {
+			#power-domain-cells = <0>;
+			power-domains = <&cluster_pd>;
+			domain-idle-states = <&cpu_sleep_0_0>;
+		};
+		cpu_pd2: power-domain-cpu2 {
+			#power-domain-cells = <0>;
+			power-domains = <&cluster_pd>;
+			domain-idle-states = <&cpu_sleep_0_0>;
+		};
+		cpu_pd3: power-domain-cpu3 {
+			#power-domain-cells = <0>;
+			power-domains = <&cluster_pd>;
+			domain-idle-states = <&cpu_sleep_0_0>;
+		};
+		cpu_pd4: power-domain-cpu4 {
+			#power-domain-cells = <0>;
+			power-domains = <&cluster_pd>;
+			domain-idle-states = <&cpu_sleep_0_0>;
+		};
+		cpu_pd5: power-domain-cpu5 {
+			#power-domain-cells = <0>;
+			power-domains = <&cluster_pd>;
+			domain-idle-states = <&cpu_sleep_0_0>;
+		};
+		cpu_pd6: power-domain-cpu6 {
+			#power-domain-cells = <0>;
+			power-domains = <&cluster_pd>;
+			domain-idle-states = <&cpu_sleep_1_0>;
+		};
+		cpu_pd7: power-domain-cpu7 {
+			#power-domain-cells = <0>;
+			power-domains = <&cluster_pd>;
+			domain-idle-states = <&cpu_sleep_1_0>;
+		};
+		cluster_pd: power-domain-cpu-cluster0 {
+			#power-domain-cells = <0>;
+			domain-idle-states = <&cluster_sleep_0_0>;
+		};
+	};
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		memory@80000000 {
+			reg = <0 0x80000000 0 0x600000>;
+			no-map;
+		};
+		xbl_aop_mem: memory@80600000 {
+			/* live dts: xbl_aop_region 实为 0x80600000+0x260000，此前少保留 0x80600000-0x80700000 */
+			reg = <0 0x80600000 0 0x260000>;
+			no-map;
+		};
+		cmd_db: memory@80860000 {
+			compatible = "qcom,cmd-db";
+			reg = <0 0x80860000 0 0x20000>;
+			no-map;
+		};
+		xbl_uefi_log_mem: memory@80880000 {
+			/* live dts: res_xbl_uefi_log_region */
+			reg = <0 0x80880000 0 0x14000>;
+			no-map;
+		};
+		smem_mem: memory@80900000 {
+			reg = <0 0x80900000 0 0x200000>;
+			no-map;
+		};
+		removed_mem: memory@80b00000 {
+			reg = <0 0x80b00000 0 0x1300000>;
+			no-map;
+		};
+		sec_apps_mem: memory@808ff000 {
+			reg = <0 0x808ff000 0 0x1000>;
+			no-map;
+		};
+		qtee_apps_mem: memory@81e00000 {
+			reg = <0 0x81e00000 0 0x4200000>;
+			no-map;
+		};
+		pil_camera_mem: memory@86000000 {
+			reg = <0 0x86000000 0 0x500000>;
+			no-map;
+		};
+		pil_npu_mem: memory@86500000 {
+			reg = <0 0x86500000 0 0x500000>;
+			no-map;
+		};
+		pil_video_mem: memory@86a00000 {
+			reg = <0 0x86a00000 0 0x500000>;
+			no-map;
+		};
+		pil_cdsp_mem: memory@87400000 {
+			reg = <0 0x87400000 0 0x1e00000>;
+			no-map;
+		};
+		pil_wlan_mem: memory@8ba00000 {
+			reg = <0 0x8ba00000 0 0x200000>;
+			no-map;
+		};
+		pil_ipa_fw_mem: memory@8bc00000 {
+			reg = <0 0x8bc00000 0 0x10000>;
+			no-map;
+		};
+		pil_ipa_gsi_mem: memory@8bc10000 {
+			reg = <0 0x8bc10000 0 0x5400>;
+			no-map;
+		};
+		pil_adsp_mem: memory@89200000 {
+			reg = <0 0x89200000 0 0x2800000>;
+			no-map;
+		};
+		modem_wlan_mem: memory@8c000000 {
+			reg = <0 0x8c000000 0 0xf800000>;
+			no-map;
+		};
+		cdsp_sec_mem: memory@9f400000 {
+			reg = <0 0x9f400000 0 0xc00000>;
+			no-map;
+		};
+		pil_gpu_mem: pil-gpu-mem@8bc15400 {
+			reg = <0 0x8bc15400 0 0x2000>;
+			no-map;
+		};
+		reserved_pil_mem: memory@8bc17400 {
+			/* live dts: reserved_pil_mem_region，补齐 0x8bc17400-0x8c000000 空洞 */
+			reg = <0 0x8bc17400 0 0x3e8c00>;
+			no-map;
+		};
+	};
+	smem: smem {
+		compatible = "qcom,smem";
+		memory-region = <&smem_mem>;
+		hwlocks = <&tcsr_mutex 3>;
+	};
+	smp2p_adsp: smp2p-adsp {
+		compatible = "qcom,smp2p";
+		qcom,smem = <0x1bb 0x1ad>;
+		interrupts-extended = <&aoss_qmp 3 2 4>;
+		mboxes = <&aoss_qmp 3 2>;
+		qcom,local-pid = <0>;
+		qcom,remote-pid = <2>;
+		adsp_smp2p_out: master-kernel {
+			qcom,entry-name = "master-kernel";
+			#qcom,smem-state-cells = <1>;
+		};
+		adsp_smp2p_in: slave-kernel {
+			qcom,entry-name = "slave-kernel";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+		sleepstate_smp2p_out: sleepstate {
+			qcom,entry-name = "sleepstate";
+			#qcom,smem-state-cells = <1>;
