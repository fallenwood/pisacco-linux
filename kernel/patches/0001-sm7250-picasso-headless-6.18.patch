+			wakeup-source;
+		};
+	};
+	pmic-glink {
+		compatible = "qcom,sm7250-pmic-glink", "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+				port@0 {
+					reg = <0>;
+					endpoint {
+						remote-endpoint =
+							<&usb_1_dwc3_ss_out>;
+					};
+				};
+				port@1 {
+					reg = <1>;
+					endpoint {
+						remote-endpoint =
