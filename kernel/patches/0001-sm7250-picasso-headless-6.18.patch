+					};
+				};
+			};
+		};
+	};
+};
+&tlmm {
+	qup_i2c0_default: qup-i2c0-default {
+		pins = "gpio42", "gpio43";
+		function = "qup00";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	qup_i2c1_default: qup-i2c1-default {
+		pins = "gpio0", "gpio1";
+		function = "qup01";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	qup_i2c4_default: qup-i2c4-default {
+		pins = "gpio31", "gpio32";
+		function = "qup04";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	qup_i2c6_default: qup-i2c6-default {
+		pins = "gpio59", "gpio60";
+		function = "qup10";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	qup_i2c7_default: qup-i2c7-default {
+		pins = "gpio6", "gpio7";
+		function = "qup11";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	qup_i2c8_default: qup-i2c8-default {
+		pins = "gpio49", "gpio50";
+		function = "qup12";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	qup_i2c9_default: qup-i2c9-default {
+		pins = "gpio46", "gpio47";
+		function = "qup13";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	qup_i2c10_default: qup-i2c10-default {
+		pins = "gpio53", "gpio54";
+		function = "qup14";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	qup_i2c11_default: qup-i2c11-default {
+		pins = "gpio108", "gpio109";
+		function = "qup15";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	qup_uart2_default: qup-uart2-default {
+		pins = "gpio36", "gpio37";
+		function = "qup02";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	qup_uart5_default: qup-uart5-default {
+		pins = "gpio38", "gpio41";
+		function = "qup05";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	qup_spi7_active: qup-spi7-active {
+		/* 触摸 SE7 SPI（live dts qupv3_se7_spi、ts 系列组实测参数） */
+		pins = "gpio6", "gpio7", "gpio8";
+		function = "qup11";
+		drive-strength = <6>;
+		bias-disable;
+	};
+	qup_spi7_sleep: qup-spi7-sleep {
+		pins = "gpio6", "gpio7", "gpio8";
+		function = "gpio";
+		drive-strength = <6>;
+		bias-disable;
+	};
+	ts_int_active: ts-int-active {
+		pins = "gpio5";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-pull-down;
+	};
+	ts_reset_active: ts-reset-active {
+		pins = "gpio4";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-pull-up;
+	};
+	ts_cs_active: ts-cs-active {
+		pins = "gpio9";
+		function = "qup11";
+		drive-strength = <6>;
+		bias-disable;
+	};
+	ts_cs_suspend: ts-cs-suspend {
+		pins = "gpio9";
+		function = "gpio";
+		drive-strength = <6>;
+		bias-pull-down;
+		output-low;
+	};
+	ts_int_suspend: ts-int-suspend {
+		pins = "gpio5";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		input-enable;
+	};
+	ts_reset_suspend: ts-reset-suspend {
+		pins = "gpio4";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+	};
+	ufs_dev_reset_assert: ufs-dev-reset-assert {
+		/* UFS 设备复位：TLMM 专用 ufs_reset 组（pin 146，非 gpio
+					 * 范围，gpiod 够不着）——ufs-qcom 走 pinctrl 两态
+					 * （迭代 32）。参数照 live_dts 实值（bias-pull-down +
+					 * drive 8 + output 电平），无 function（mux_bit=-1 的
+					 * 特殊组只走 config）。注：7.3 的 generic pinconf 把
+					 * output-high/low 解析为 PIN_CONFIG_LEVEL，pinctrl-msm
+					 * 原生支持该路径（io_reg 写电平）——无需框架改动 */
+		pins = "ufs_reset";
+		drive-strength = <8>;
+		bias-pull-down;
+		output-low;
+	};
+	ufs_dev_reset_deassert: ufs-dev-reset-deassert {
+		pins = "ufs_reset";
+		drive-strength = <8>;
+		bias-pull-down;
+		output-high;
+	};
+	sdc2_default: sdc2-default {
+		clk {
+			pins = "sdc2_clk";
+			drive-strength = <16>;
+			bias-disable;
+		};
+		cmd {
+			pins = "sdc2_cmd";
+			drive-strength = <10>;
+			bias-pull-up;
+		};
+		data {
+			pins = "sdc2_data";
+			drive-strength = <10>;
+			bias-pull-up;
+		};
+		sd-cd {
+			pins = "gpio69";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+};
+&apps_rsc {
+	pm8150_regulators: regulators-0 {
+		compatible = "qcom,pm8150-rpmh-regulators";
+		qcom,pmic-id = "a";
+		vreg_s4a_1p8: smps4 {
+			regulator-name = "vreg_s4a_1p8";
+			regulator-min-microvolt = <0x1b7740>;
+			regulator-max-microvolt = <0x1b7740>;
+			regulator-initial-mode = <3>;
+		};
+		vreg_s5a_1p9: smps5 {
+			regulator-name = "vreg_s5a_1p9";
+			regulator-min-microvolt = <0x1d0d80>;
+			regulator-max-microvolt = <0x1f20c0>;
+			regulator-initial-mode = <3>;
+		};
+		vreg_l1a_0p75: ldo1 {
+			/* ldoa1 = pmic5_nldo（0.312-1.328V），保持原值（无消费者）。
+							   注意：下游运行时树里名叫 "pm8150a_l1" 的 1.896V 面板 vddio
+							   实际挂在 ldoc1（其父块是 rpmh-regulator-ldoc1，小米 R 的
+							   命名误导）——见 regulators-1 的 ldo1 */
+			regulator-name = "vreg_l1a_0p75";
+			regulator-min-microvolt = <0xb7980>;
+			regulator-max-microvolt = <0xb7980>;
+			regulator-initial-mode = <1>;
+		};
+		vreg_l2a_3p1: ldo2 {
+			regulator-name = "vreg_l2a_3p1";
+			regulator-min-microvolt = <0x2ee000>;
+			regulator-max-microvolt = <0x2ee000>;
+			regulator-initial-mode = <1>;
+		};
+		vreg_l5a_0p875: ldo5 {
+			regulator-name = "vreg_l5a_0p875";
+			regulator-min-microvolt = <0xd6d80>;
+			regulator-max-microvolt = <0xd6d80>;
+			/* P41: UFS/DSI analog supply stays in HPM. */
+			regulator-initial-mode = <3>;
+			regulator-allow-set-load;
+			regulator-allowed-modes = <3>;
+		};
+		vreg_l7a_1p8: ldo7 {
+			regulator-name = "vreg_l7a_1p8";
+			regulator-min-microvolt = <0x1b7740>;
+			regulator-max-microvolt = <0x1b7740>;
+			regulator-initial-mode = <1>;
+		};
+		vreg_l9a_1p2: ldo9 {
+			regulator-name = "vreg_l9a_1p2";
+			regulator-min-microvolt = <0x124f80>;
+			regulator-max-microvolt = <0x124f80>;
+			/* 19mA UFS load is below the 30mA HPM threshold. */
+			regulator-initial-mode = <3>;
+			regulator-allow-set-load;
+			regulator-allowed-modes = <3>;
+		};
+		vreg_l12a_1p8: ldo12 {
+			regulator-name = "vreg_l12a_1p8";
+			regulator-min-microvolt = <0x1b7740>;
+			regulator-max-microvolt = <0x1b7740>;
+			regulator-initial-mode = <1>;
+		};
+	};
+	pm8150l_regulators: regulators-1 {
+		/* lito 固件里 PM8150L 的 cmd-db 资源前缀是 "c"（ldoc1-11/smpc2,7,8/bobc1），
+						   不是 kona 的 "l"；用 "l" 会在 cmd_db_read_addr("ldol1") 处 -ENODEV */
+		compatible = "qcom,pm8150l-rpmh-regulators";
+		qcom,pmic-id = "c";
+		vreg_l1c_1p896: ldo1 {
+			/* 面板 vddio：实为 PM8150L ldoc1 @1.896V（pldo_lv
+							   1.504-2.0V@8mV 可精确命中；下游 picasso &L1C 同值） */
+			regulator-name = "vreg_l1c_1p896";
+			regulator-min-microvolt = <0x1cee40>;
+			regulator-max-microvolt = <0x1cee40>;
+			regulator-initial-mode = <3>;
+		};
+		vreg_l2c_1p1: ldo2 {
+			/* ldoc2 = pmic5_nldo（上限 1.328V），旧 3.008V 超范围导致
+							   regs-1 整组 -131。改回范围内值（无消费者） */
+			regulator-name = "vreg_l2c_1p1";
+			regulator-min-microvolt = <0x1174c0>;
+			regulator-max-microvolt = <0x1174c0>;
+			regulator-initial-mode = <1>;
+		};
+		vreg_l3c_1p2: ldo3 {
+			regulator-name = "vreg_l3c_1p2";
+			regulator-min-microvolt = <0x124f80>;
+			regulator-max-microvolt = <0x124f80>;
+			regulator-initial-mode = <1>;
+		};
+		vreg_l7c_2p95: ldo7 {
+			regulator-name = "vreg_l7c_2p95";
+			regulator-min-microvolt = <0x2d0370>;
+			regulator-max-microvolt = <0x2d2a80>;
+			/* UFS VCC: enable load voting and keep HPM. */
+			regulator-initial-mode = <3>;
+			regulator-allow-set-load;
+			regulator-allowed-modes = <3>;
+		};
+		vreg_bob: bob {
+			/* live_dts bobc1: 3.008..3.96V；WCD9385 mic-bias 供轨 */
+			regulator-name = "vreg_bob";
+			regulator-min-microvolt = <0x2de600>;
+			regulator-max-microvolt = <0x3c6cc0>;
+			regulator-initial-mode = <3>;
+		};
+	};
+};
+&spmi_bus {
+	pm8150l_1: pmic@5 {
+		/* 下游 pm8150l.dtsi：WLED/LCDB 在 USID 5（SPMI 外设按 USID
+					   寻址，放错 USID 写入无响应） */
+		compatible = "qcom,pm8150l", "qcom,spmi-pmic";
+		reg = <5 0>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		pm8150l_lcdb: lcdb@ec00 {
+			compatible = "qcom,pm8150l-lcdb";
+			/* SPMI 孙节点 #size-cells=0：reg 为地址段列表；
+								   驱动用第 0 段（0xec00），第二段预留（主线 wled 模式） */
+			reg = <0xec00>, <0xed00>;
+			lcdb_ldo: ldo {
+				/* 面板 avdd（正 bias） */
+				regulator-name = "lcdb_ldo";
+				regulator-min-microvolt = <0x53ec60>;
+				regulator-max-microvolt = <0x53ec60>;
+			};
+			lcdb_ncp: ncp {
