[Unit]
Description=Picasso native tty1 console screen idle (no system suspend)
Requires=getty@tty1.service
After=local-fs.target systemd-udevd.service getty@tty1.service
ConditionPathExists=/dev/fb0
ConditionPathExists=/dev/input/event0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -I /opt/picasso-screen/screen-service.py
ExecStopPost=/usr/bin/python3 -I /opt/picasso-screen/screen-service.py --cleanup
Restart=no
WatchdogSec=8s
TimeoutStartSec=30s
TimeoutStopSec=15s
KillMode=control-group
OOMPolicy=stop
UMask=0077
RuntimeDirectory=picasso-screen
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=picasso-screen
StateDirectoryMode=0700
MemoryMax=128M
CPUAffinity=0 1 2 3
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_MODULE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=~@mount @reboot @swap @raw-io @clock
InaccessiblePaths=-/sys/power/state -/sys/power/disk -/sys/power/mem_sleep
DevicePolicy=closed
DeviceAllow=/dev/fb0 r
DeviceAllow=/dev/input/event0 r
DeviceAllow=/dev/input/event1 r
DeviceAllow=/dev/tty1 r

[Install]
WantedBy=multi-user.target
