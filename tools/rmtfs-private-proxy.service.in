# Experimental attended trial ONLY; render after native RMTFS memory validation.
# @WORKDIR@ contains NEW regular 0600 copies, never original NV partitions.
[Unit]
Description=Picasso bounded FD-only private-copy RMTFS trial

[Service]
Type=exec
DynamicUser=yes
User=picasso-rmtfs-trial
RootDirectory=/opt/picasso-wifi-trial/python-jail
MountAPIVFS=no
BindReadOnlyPaths=/usr
OpenFile=/dev/qcom_rmtfs_mem1:rmtfs_mem
OpenFile=@WORKDIR@/modem_fs1:modem_fs1
OpenFile=@WORKDIR@/modem_fs2:modem_fs2
OpenFile=@WORKDIR@/modem_fsg:modem_fsg
ExecStart=/usr/bin/python3 -I /proxy/rmtfs-private-proxy.py --confirm-private-copy-only --memory-base @MEM_BASE@ --memory-major @MEM_MAJOR@ --memory-minor @MEM_MINOR@ --library /proxy/libqrtr.so.1 --library-sha256 9bda78129abc57218822bd9bb97283189658708bc73099c19e4e8f610dc59402 --duration 120
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
DevicePolicy=closed
DeviceAllow=/dev/qcom_rmtfs_mem1 rw
InaccessiblePaths=/proc /sys /etc/ssh /home /root
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_QIPCRTR
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RuntimeMaxSec=150s
MemoryMax=128M
Restart=no
StandardOutput=journal
StandardError=journal
