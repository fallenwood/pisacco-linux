[Unit]
Description=Picasso physical power-key release-only orderly shutdown (USB autostart unresolved)
After=local-fs.target systemd-udevd.service systemd-logind.service
ConditionPathExists=/dev/input/event0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -I /opt/picasso-power-button/power-button-daemon.py --run-installed
Restart=no
WatchdogSec=8s
TimeoutStartSec=140s
TimeoutStopSec=15s
KillMode=control-group
OOMPolicy=stop
UMask=0077
RuntimeDirectory=picasso-power-button
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=picasso-power-button
StateDirectoryMode=0700
MemoryMax=128M
CPUAffinity=0 1 2 3
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
SystemCallFilter=~@mount @reboot @swap @raw-io @clock @module
InaccessiblePaths=-/sys/power/state -/sys/power/disk -/sys/power/mem_sleep
DevicePolicy=closed
DeviceAllow=/dev/input/event0 r
DeviceAllow=/dev/input/event1 r

[Install]
WantedBy=multi-user.target
