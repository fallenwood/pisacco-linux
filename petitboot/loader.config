# Diagnostic menu candidate: USB log output, no disk, IP or radio.
CONFIG_LOCALVERSION="-picasso-petitboot2"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_CMDLINE="earlycon=qcom_geni,0x888000 console=ttyGS0 console=tty0 console=ttyMSM0,115200 rdinit=/init clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=0 enforcing=0 loglevel=7 printk.devkmsg=on g_serial.use_acm=1 g_serial.use_obex=0 g_serial.n_ports=1 g_serial.iSerialNumber=picasso-menu-diagnostics"
CONFIG_CMDLINE_FORCE=y
CONFIG_EXPERT=y
CONFIG_BLOCK=n
CONFIG_INET=n
CONFIG_IPV6=n
CONFIG_PACKET=n
CONFIG_NETFILTER=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_REMOTEPROC=n
CONFIG_RPMSG=n
CONFIG_RPMSG_QCOM_GLINK_RPM=n
CONFIG_RPMSG_QCOM_GLINK_SMEM=n
CONFIG_RPMSG_QCOM_SMD=n
CONFIG_RPMSG_VIRTIO=n
CONFIG_QRTR=n
CONFIG_QCOM_RMTFS_MEM=n
CONFIG_QCOM_PD_MAPPER=n
CONFIG_MODPROBE_PATH=""
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_CONFIGFS=n
CONFIG_USB_NET_DRIVERS=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_LOG_BUF_SHIFT=20
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE=y
