+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PB_PHONE_INPUT_H
+#define PB_PHONE_INPUT_H
+
+#include <stdint.h>
+
+enum pb_phone_key {
+	PB_PHONE_NONE,
+	PB_PHONE_UP,
+	PB_PHONE_DOWN,
+	PB_PHONE_CONFIRM,
+};
+
+struct pb_phone_input {
+	int fd;
+	unsigned int supported;
+	unsigned int down;
+	unsigned int blocked;
+	int64_t power_pressed;
+	int64_t opened_at;
+};
+
+int pb_phone_open(struct pb_phone_input *input, const char *path);
+int pb_phone_read(struct pb_phone_input *input);
+int pb_phone_event(struct pb_phone_input *input, unsigned int type,
+		unsigned int code, int value, int64_t usec);
+
+#endif
