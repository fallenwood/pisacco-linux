diff --git a/test/lib/test-phone-input.c b/test/lib/test-phone-input.c
new file mode 100644
index 0000000..b9f4f71
--- /dev/null
+++ b/test/lib/test-phone-input.c
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <assert.h>
+#include <errno.h>
+#include <linux/input.h>
+#include <unistd.h>
+
+#include "ui/ncurses/phone-input.h"
+
+int main(void)
+{
+	struct pb_phone_input input = { .opened_at = 1000000 };
+	int fds[2];
+
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 1, 900000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 0, 1100000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 1, 1200000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 2, 1300000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 0, 1400000) ==
+			PB_PHONE_CONFIRM);
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 0, 1500000) == 0);
+
+	input.down = input.blocked = 4;
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 1, 1600000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 0, 1700000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 1, 1800000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 0, 3000000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 1, 3100000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 0, 3110000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 1, 3200000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_POWER, 0, 3400000) ==
+			PB_PHONE_CONFIRM);
+
+	assert(pb_phone_event(&input, EV_KEY, KEY_VOLUMEUP, 1, 3500000) ==
+			PB_PHONE_UP);
+	assert(pb_phone_event(&input, EV_KEY, KEY_VOLUMEUP, 1, 3510000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_VOLUMEUP, 2, 3520000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_VOLUMEUP, 0, 3600000) == 0);
+	assert(pb_phone_event(&input, EV_KEY, KEY_VOLUMEDOWN, 1, 3700000) ==
+			PB_PHONE_DOWN);
+	assert(pb_phone_event(&input, EV_SYN, SYN_DROPPED, 0, 3800000) == -1);
+	assert(errno == EIO);
+
+	assert(pb_phone_open(&input, "/dev/null") == -1);
+	assert(pipe(fds) == 0);
+	input.fd = fds[0];
+	assert(write(fds[1], "x", 1) == 1);
+	assert(pb_phone_read(&input) == -1 && errno == EPROTO);
+	close(fds[1]);
+	assert(pb_phone_read(&input) == -1 && errno == ENODEV);
+	close(fds[0]);
+	return 0;
+}
