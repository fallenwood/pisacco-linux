+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "parser-test.h"
+
+#if 0 /* PARSER_EMBEDDED_CONFIG */
+LABEL linux-new
+KERNEL file:///kernels/new/Image
+FDT file:///kernels/new/board.dtb
+APPEND console=tty0
+LABEL linux-rescue
+KERNEL file:///kernels/rescue/Image
+DTB file:///kernels/rescue/board.dtb
+APPEND console=tty0 rescue
+#endif
+
+void run_test(struct parser_test *test)
+{
+	struct discover_boot_option *opt;
+
+	test_read_conf_embedded_url(test, "file:///menu.conf");
+	test_set_event_source(test);
+	test_set_event_param(test->ctx->event, "pxeconffile", "file:///menu.conf");
+	test_run_parser(test, "pxe");
+	check_boot_option_count(test->ctx, 2);
+	opt = get_boot_option(test->ctx, 0);
+	check_name(opt, "linux-new");
+	check_resolved_url_resource(opt->boot_image, "file:///kernels/new/Image");
+	check_resolved_url_resource(opt->dtb, "file:///kernels/new/board.dtb");
+	check_args(opt, "console=tty0");
+	opt = get_boot_option(test->ctx, 1);
+	check_name(opt, "linux-rescue");
+	check_resolved_url_resource(opt->boot_image, "file:///kernels/rescue/Image");
+	check_resolved_url_resource(opt->dtb, "file:///kernels/rescue/board.dtb");
+	check_args(opt, "console=tty0 rescue");
+}
