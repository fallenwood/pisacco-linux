+struct cui_phone_input {
+	struct cui *cui;
+	struct pb_phone_input input;
+	struct waiter *waiter;
+};
+
+static int cui_phone_input_destroy(void *arg)
+{
+	struct cui_phone_input *source = arg;
+
+	if (source->waiter)
+		waiter_remove(source->waiter);
+	close(source->input.fd);
+	return 0;
+}
+
+static int cui_process_phone_input(void *arg)
+{
+	struct cui_phone_input *source = arg;
+	int key = pb_phone_read(&source->input);
+
+	if (key < 0) {
+		pb_log("Phone input lost: %s; stopping menu\n", strerror(errno));
+		source->cui->phone_input_failed = true;
+		cui_abort(source->cui);
+		return 0;
+	}
+	if (key != PB_PHONE_NONE) {
+		ungetch(key == PB_PHONE_UP ? KEY_UP :
+			key == PB_PHONE_DOWN ? KEY_DOWN : '\n');
+		cui_process_key(source->cui);
+	}
+	return 0;
+}
+
+int cui_add_input_events(struct cui *cui, const char **paths, unsigned int count)
+{
+	unsigned int i, supported = 0;
+
+	for (i = 0; i < count; i++) {
+		struct cui_phone_input *source;
+
+		source = talloc_zero(cui, struct cui_phone_input);
+		if (!source)
+			return -1;
+		source->cui = cui;
+		if (pb_phone_open(&source->input, paths[i])) {
+			pb_log("Cannot open phone input %s: %s\n",
