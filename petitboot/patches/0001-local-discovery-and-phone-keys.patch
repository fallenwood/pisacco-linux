diff --git a/ui/ncurses/phone-input.c b/ui/ncurses/phone-input.c
new file mode 100644
index 0000000..8337371
--- /dev/null
+++ b/ui/ncurses/phone-input.c
@@ -0,0 +1,141 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/input.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "phone-input.h"
+
+#define WORD_BITS (8 * sizeof(unsigned long))
+#define BIT_SET(bits, bit) ((bits)[(bit) / WORD_BITS] & \
+		(1UL << ((bit) % WORD_BITS)))
+
+static const unsigned int codes[] = {
+	KEY_VOLUMEUP, KEY_VOLUMEDOWN, KEY_POWER,
+};
+
+int pb_phone_event(struct pb_phone_input *input, unsigned int type,
+		unsigned int code, int value, int64_t usec)
+{
+	unsigned int i, bit;
+	int64_t duration;
+
+	if (type == EV_SYN && code == SYN_DROPPED) {
+		errno = EIO;
+		return -1;
+	}
+	if (type != EV_KEY || usec < input->opened_at)
+		return PB_PHONE_NONE;
+	for (i = 0; i < sizeof(codes) / sizeof(codes[0]); i++)
+		if (code == codes[i])
+			break;
+	if (i == sizeof(codes) / sizeof(codes[0]) || value == 2)
+		return PB_PHONE_NONE;
+	if (value != 0 && value != 1) {
+		errno = EPROTO;
+		return -1;
+	}
+
+	bit = 1U << i;
+	if (value == 1) {
+		if ((input->down | input->blocked) & bit)
+			return PB_PHONE_NONE;
+		input->down |= bit;
+		if (code == KEY_POWER) {
+			input->power_pressed = usec;
+			return PB_PHONE_NONE;
+		}
+		return code == KEY_VOLUMEUP ? PB_PHONE_UP : PB_PHONE_DOWN;
+	}
+
+	if (!(input->down & bit) || (input->blocked & bit)) {
+		input->blocked &= ~bit;
+		input->down &= ~bit;
+		return PB_PHONE_NONE;
+	}
+	input->down &= ~bit;
+	if (code != KEY_POWER)
+		return PB_PHONE_NONE;
+
+	duration = usec - input->power_pressed;
+	return duration >= 50000 && duration <= 1000000 ?
+		PB_PHONE_CONFIRM : PB_PHONE_NONE;
+}
+
+int pb_phone_open(struct pb_phone_input *input, const char *path)
+{
+	unsigned long supported[(KEY_MAX + WORD_BITS) / WORD_BITS] = {0};
+	unsigned long held[(KEY_MAX + WORD_BITS) / WORD_BITS] = {0};
+	struct timespec now;
+	struct stat st;
+	unsigned int i;
+	int saved, clock_id = CLOCK_MONOTONIC;
+
+	memset(input, 0, sizeof(*input));
+	input->fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC | O_NOFOLLOW);
+	if (input->fd < 0)
+		return -1;
+	if (fstat(input->fd, &st))
+		goto fail;
+	if (!S_ISCHR(st.st_mode)) {
+		errno = ENODEV;
+		goto fail;
+	}
+	if (ioctl(input->fd, EVIOCSCLOCKID, &clock_id) ||
+			ioctl(input->fd, EVIOCGBIT(EV_KEY, sizeof(supported)),
+				supported) < 0 ||
+			ioctl(input->fd, EVIOCGKEY(sizeof(held)), held) < 0 ||
+			clock_gettime(CLOCK_MONOTONIC, &now))
+		goto fail;
+	for (i = 0; i < sizeof(codes) / sizeof(codes[0]); i++) {
+		if (BIT_SET(supported, codes[i]))
+			input->supported |= 1U << i;
+		if (BIT_SET(held, codes[i]))
+			input->blocked |= 1U << i;
+	}
+	if (!input->supported) {
+		errno = ENODEV;
+		goto fail;
+	}
+	input->down = input->blocked;
+	input->opened_at = (int64_t)now.tv_sec * 1000000 + now.tv_nsec / 1000;
+	return 0;
+
+fail:
+	saved = errno;
+	close(input->fd);
+	input->fd = -1;
+	errno = saved;
+	return -1;
+}
+
+int pb_phone_read(struct pb_phone_input *input)
+{
+	struct input_event event;
+	ssize_t n;
+	int key;
+
+	for (;;) {
+		n = read(input->fd, &event, sizeof(event));
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			if (errno == EAGAIN)
+				return PB_PHONE_NONE;
+			return -1;
+		}
+		if (n != sizeof(event)) {
+			errno = n == 0 ? ENODEV : EPROTO;
+			return -1;
+		}
+		key = pb_phone_event(input, event.type, event.code, event.value,
+			(int64_t)event.time.tv_sec * 1000000 + event.time.tv_usec);
+		if (key != PB_PHONE_NONE)
+			return key;
+	}
+}
